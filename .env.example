# Copiez ce fichier en .env si vous souhaitez activer des intégrations.
# Le lancement sans .env fonctionne : l'IA et les envois restent désactivés.
ORBITA_PORT=8080
ORBITA_TIMEZONE=Europe/Paris

# IA : disabled, openai ou ollama. Aucun modèle n'est choisi implicitement.
ORBITA_AI_PROVIDER=disabled
ORBITA_AI_MODEL=
ORBITA_AI_DAILY_LIMIT=50
OPENAI_API_KEY=
# Dans Docker, le serveur Ollama de votre ordinateur est accessible via :
ORBITA_OLLAMA_URL=http://host.docker.internal:11434

# SMTP : un compte est explicitement rattaché à un seul espace Orbita.
# Retrouvez l'identifiant de l'espace dans Paramètres.
ORBITA_SMTP_SPACE_ID=
ORBITA_SMTP_HOST=
ORBITA_SMTP_PORT=587
ORBITA_SMTP_USER=
ORBITA_SMTP_PASSWORD=
ORBITA_SMTP_AUTH=true
ORBITA_SMTP_STARTTLS=true
ORBITA_MAIL_FROM=

# GitHub : sans jeton, la lecture des dépôts publics fonctionne.
# Un jeton n'est utilisé que dans l'espace désigné ci-dessous.
ORBITA_GITHUB_SPACE_ID=
ORBITA_GITHUB_TOKEN=

# PostgreSQL : nécessaire uniquement avec compose.postgres.yml.
ORBITA_DATABASE_PASSWORD=

# À activer uniquement derrière un accès HTTPS correctement configuré.
ORBITA_SECURE_COOKIES=false
