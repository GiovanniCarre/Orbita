# Identifiants locaux de développement uniquement ; changer avant toute exposition.
POSTGRES_DB=orbita
POSTGRES_USER=orbita
POSTGRES_PASSWORD=change-me-locally

# Modules activés, séparés par des virgules (overview, social). Vide : tous les modules.
ORBITA_MODULES=

# Production uniquement : dossier de l'interface compilée, servie par l'API (voir docs/deploy.md).
# ORBITA_STATIC_DIR=/opt/orbita/frontend/build

# Connexion à Orbita : un seul compte (adresse e-mail + mot de passe).
ORBITA_LOGIN_EMAIL=giovannicarre49@gmail.com
# Empreinte du mot de passe, générée par : docker compose run --rm --build -it backend python -m app.auth.password
ORBITA_PASSWORD_HASH=
# Secret de signature des sessions, 32 caractères minimum : openssl rand -hex 32
ORBITA_SESSION_SECRET=

# Gmail : lecture et envoi. Configurer un client OAuth Google et garder les secrets hors du dépôt.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_SPORTCOOKS_ADDRESS=contact@sportcooks.fr

# Meta for Developers. Garder les secrets dans .env, jamais dans le dépôt.
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v26.0

# En production, configurer l'URL HTTPS publique qui reçoit les callbacks OAuth.
ORBITA_API_PUBLIC_URL=http://localhost:8000
ORBITA_FRONTEND_PUBLIC_URL=http://localhost:5173
