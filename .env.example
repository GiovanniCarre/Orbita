# Identifiants locaux de développement uniquement ; changer avant toute exposition.
POSTGRES_DB=orbita
POSTGRES_USER=orbita
POSTGRES_PASSWORD=change-me-locally

# Meta for Developers. Garder les secrets dans .env, jamais dans le dépôt.
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v26.0

# En production, configurer l'URL HTTPS publique qui reçoit les callbacks OAuth.
ORBITA_API_PUBLIC_URL=http://localhost:8000
ORBITA_FRONTEND_PUBLIC_URL=http://localhost:5173
